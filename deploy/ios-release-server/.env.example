# Public HTTPS base URL the phone uses (reverse proxy or Tailscale MagicDNS).
# source.json and every download URL are built from it.
PUBLIC_BASE_URL=https://apps.example.ts.net

# GitHub repository with the ios-sideload workflow, as owner/name.
GITHUB_REPO=your-user/SparkyFitness
# Only needed for a private repository: a fine-grained token with read-only
# "Contents" access to that one repository. Leave empty for public repos.
GITHUB_TOKEN=
POLL_INTERVAL=300
TAG_PREFIX=sideload-v

# Must match the bundle id the workflow builds (IOS_SIDELOAD_BUNDLE_IDENTIFIER).
BUNDLE_ID=com.sparkyfitness.personal
APP_NAME=SparkyFitness
SOURCE_NAME=SparkyFitness (personal)
DEVELOPER_NAME=Self-hosted
TINT_COLOR=#22C55E
# Releases whose IPA files are kept (older ones are pruned; the current one never is).
KEEP_RELEASES=10

# Host binding of the static server.
RELEASE_WEB_BIND=127.0.0.1
RELEASE_WEB_PORT=8088
