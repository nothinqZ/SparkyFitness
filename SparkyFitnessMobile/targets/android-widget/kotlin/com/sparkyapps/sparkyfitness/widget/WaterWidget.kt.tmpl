/**
 * Today's water with − and + buttons that remove or add one drink of the
 * dashboard's container without opening the app, the Android side of the iOS
 * water widget (targets/widget/waterWidget.swift). Drawn in a fixed 2x2 like
 * the macro widget, with a bar like the other Android widgets. A tap anywhere
 * else opens the app.
 *
 * The buttons only show once the Dashboard has sent its container (`canLog`,
 * false until then, as on iOS) and that container logs plain water (one
 * linked to a food has no drink size). A tap shows at once and is sent by
 * [WaterWidgetWorker]; the server's total replaces the guess when it answers.
 */
class WaterWidget : GlanceAppWidget() {

    override val stateDefinition = PreferencesGlanceStateDefinition

    // One size matching the fixed 2x2 launcher footprint, like the macro widget.
    override val sizeMode: SizeMode = SizeMode.Responsive(
        setOf(DpSize(200.dp, 200.dp)),
    )

    override suspend fun provideGlance(context: Context, id: GlanceId) {
        provideContent {
            GlanceTheme {
                WidgetContent(context = context)
            }
        }
    }

    @Composable
    private fun WidgetContent(context: Context) {
        val state = currentState<Preferences>()
        // Observe the dedicated revision so an active Glance session recomposes
        // after a language-only invalidation.
        currentState(WidgetLocale.LOCALE_RENDER_REVISION_STATE_KEY)
        // The stored copy is read here rather than once per session, so a
        // snapshot cleared on an account change does not come back from it.
        val snapshot = WaterWidgetStore.parse(state[SNAPSHOT_STATE_KEY])
            ?: WaterWidgetStore.loadSnapshot(context)

        // Widget-only locale override: localized string and number resolution
        // stay local to widget rendering (see WidgetLocale).
        val widgetContext = WidgetLocale.localizedContext(context)

        val openAppIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://"))
            .setPackage(context.packageName)

        Box(
            modifier = GlanceModifier
                .fillMaxSize()
                .background(GlanceTheme.colors.surface)
                .appWidgetBackgroundCornerRadius()
                .padding(14.dp)
                .clickable(actionStartActivity(openAppIntent)),
            contentAlignment = Alignment.Center,
        ) {
            Column(modifier = GlanceModifier.fillMaxWidth()) {
                Row(
                    modifier = GlanceModifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Image(
                        provider = ImageProvider(R.drawable.ic_tile_log_water),
                        contentDescription = null,
                        colorFilter = ColorFilter.tint(WaterPalette.water),
                        modifier = GlanceModifier.size(18.dp),
                    )
                    Spacer(modifier = GlanceModifier.width(6.dp))
                    Text(
                        text = widgetContext.getString(R.string.widget_water_title),
                        style = TextStyle(
                            color = GlanceTheme.colors.onSurfaceVariant,
                            fontSize = 14.sp,
                        ),
                        maxLines = 1,
                    )
                }
                Spacer(modifier = GlanceModifier.height(8.dp))
                Text(
                    text = amountText(widgetContext, snapshot),
                    style = TextStyle(
                        color = GlanceTheme.colors.onSurface,
                        fontSize = 20.sp,
                        fontWeight = FontWeight.Bold,
                    ),
                    maxLines = 1,
                    modifier = GlanceModifier.fillMaxWidth(),
                )
                Spacer(modifier = GlanceModifier.height(6.dp))
                LinearProgressIndicator(
                    progress = progressOf(snapshot),
                    modifier = GlanceModifier
                        .fillMaxWidth()
                        .height(8.dp),
                    color = WaterPalette.water,
                    backgroundColor = GlanceTheme.colors.surfaceVariant,
                )
                StatusLine(context = widgetContext, snapshot = snapshot)
                if (snapshot?.showsButtons == true) {
                    Spacer(modifier = GlanceModifier.height(12.dp))
                    Row(
                        modifier = GlanceModifier.fillMaxWidth(),
                        verticalAlignment = Alignment.CenterVertically,
                    ) {
                        ChangeButton(
                            change = -1,
                            enabled = snapshot.canRemove,
                            icon = R.drawable.ic_widget_water_remove,
                            contentDescription = widgetContext.getString(
                                if (snapshot.canRemove) {
                                    R.string.widget_water_remove
                                } else {
                                    R.string.widget_water_status_nothing_to_remove
                                },
                            ),
                            modifier = GlanceModifier.defaultWeight(),
                        )
                        Spacer(modifier = GlanceModifier.width(10.dp))
                        ChangeButton(
                            change = 1,
                            enabled = true,
                            icon = R.drawable.ic_widget_water_add,
                            contentDescription = widgetContext.getString(R.string.widget_water_add),
                            modifier = GlanceModifier.defaultWeight(),
                        )
                    }
                }
            }
        }
    }

    @Composable
    private fun StatusLine(context: Context, snapshot: WaterSnapshot?) {
        val res = when (snapshot?.status) {
            WaterWidgetStore.STATUS_SIGN_IN -> R.string.widget_water_status_sign_in
            WaterWidgetStore.STATUS_PICK_CONTAINER -> R.string.widget_water_status_pick_container
            WaterWidgetStore.STATUS_EXPIRED -> R.string.widget_water_status_expired
            WaterWidgetStore.STATUS_UNREACHABLE -> R.string.widget_water_status_unreachable
            WaterWidgetStore.STATUS_FAILED -> R.string.widget_water_status_failed
            WaterWidgetStore.STATUS_NOTHING_TO_REMOVE -> R.string.widget_water_status_nothing_to_remove
            else -> return
        }
        Spacer(modifier = GlanceModifier.height(6.dp))
        Text(
            text = context.getString(res),
            style = TextStyle(
                color = GlanceTheme.colors.onSurfaceVariant,
                fontSize = 12.sp,
            ),
            maxLines = 2,
            modifier = GlanceModifier.fillMaxWidth(),
        )
    }

    @Composable
    private fun ChangeButton(
        change: Int,
        enabled: Boolean,
        icon: Int,
        contentDescription: String,
        modifier: GlanceModifier,
    ) {
        val sized = modifier.height(40.dp)
        // cornerRadius only takes effect from Android 12; before that the
        // rounded shape, and a press ripple that keeps to it, come from
        // drawables in the same colour.
        val roundsCorners = Build.VERSION.SDK_INT >= Build.VERSION_CODES.S
        val shaped = if (roundsCorners) {
            sized.cornerRadius(20.dp).background(GlanceTheme.colors.surfaceVariant)
        } else {
            sized.background(ImageProvider(R.drawable.bg_widget_water_button))
        }
        // A greyed-out button sends 0, which does nothing, so a tap on it
        // never falls through to opening the app.
        Box(
            modifier = shaped.clickable(
                actionRunCallback<WaterChangeAction>(actionParametersOf(CHANGE_KEY to if (enabled) change else 0)),
                if (roundsCorners) 0 else R.drawable.bg_widget_water_button_ripple,
            ),
            contentAlignment = Alignment.Center,
        ) {
            Image(
                provider = ImageProvider(icon),
                contentDescription = contentDescription,
                colorFilter = ColorFilter.tint(
                    if (enabled) GlanceTheme.colors.primary else GlanceTheme.colors.outline,
                ),
                modifier = GlanceModifier.size(24.dp),
            )
        }
    }

    private fun amountText(context: Context, snapshot: WaterSnapshot?): String {
        val unit = snapshot?.unit ?: "ml"
        val unitLabel = context.getString(
            when (unit) {
                "oz" -> R.string.widget_water_unit_oz
                "liter" -> R.string.widget_water_unit_liter
                else -> R.string.widget_water_unit_ml
            },
        )
        if (snapshot == null) return context.getString(R.string.widget_water_amount_empty, unitLabel)
        val shown = formatAmount(context, snapshot.shownMl, unit)
        if (snapshot.goalMl <= 0.0) {
            return context.getString(R.string.widget_water_amount_no_goal, shown, unitLabel)
        }
        return context.getString(
            R.string.widget_water_amount,
            shown,
            formatAmount(context, snapshot.goalMl, unit),
            unitLabel,
        )
    }

    private fun progressOf(snapshot: WaterSnapshot?): Float {
        if (snapshot == null || snapshot.goalMl <= 0.0) return 0f
        return (snapshot.shownMl / snapshot.goalMl).coerceIn(0.0, 1.0).toFloat()
    }

    /** In the unit the app shows water in, like the iOS widget: whole ml and oz, litres to one decimal. */
    private fun formatAmount(context: Context, ml: Double, unit: String): String {
        val value = when (unit) {
            "oz" -> ml / ML_PER_US_FLUID_OUNCE
            "liter" -> ml / 1000.0
            else -> ml
        }
        val format = NumberFormat.getNumberInstance(currentWidgetLocale(context))
        format.maximumFractionDigits = if (unit == "liter") 1 else 0
        format.minimumFractionDigits = 0
        return format.format(value)
    }

    companion object {
        val SNAPSHOT_STATE_KEY = stringPreferencesKey(WaterWidgetReceiver.PREFS_KEY_SNAPSHOT)
        val CHANGE_KEY = ActionParameters.Key<Int>("change")
        private const val ML_PER_US_FLUID_OUNCE = 29.5735295625
    }
}

private object WaterPalette {
    val water = ColorProvider(Color(0xFF4DA3FF))
}
