<?xml version="1.0"?>
<!--
  SparkyFitness strength logger for Garmin watches.
  The application id is stable: changing it makes Garmin treat the app as a
  different one and drops its settings (server URL, API key) on the watch.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="a73dfc42657448d4befbd4312730dcdc" type="watch-app" name="@Strings.AppName" entry="SparkyApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <!-- tools/build.sh adds its compile-check device here at build time. -->
            <iq:product id="epix2"/>
            <iq:product id="fenix7"/>
            <iq:product id="fenix7s"/>
            <iq:product id="fenix7x"/>
            <iq:product id="fr255"/>
            <iq:product id="fr265"/>
            <iq:product id="fr955"/>
            <iq:product id="fr965"/>
            <iq:product id="venu3"/>
            <iq:product id="vivoactive5"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Fit"/>
            <iq:uses-permission id="Sensor"/>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>deu</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
